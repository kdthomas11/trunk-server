export MAILJET_KEY="FILL IN HERE"
export MAILJET_SECRET="FILL IN HERE"
export REACT_APP_SITE_NAME=OpenMHz
export REACT_APP_ADMIN_EMAIL="admin@email.com"
export DOMAIN_NAME="openmhz.test"

# Object store. None of these has a default any more - backend/config/s3.js
# refuses to start the service without them rather than falling back to upstream
# openmhz's Wasabi bucket, which is where this file used to point. A blank value
# counts as missing.
#
# docker-test.sh omits local-compose.yml, which is the file that starts MinIO,
# so the endpoint below has to be an instance that is already running and
# reachable from the containers. docker-local.sh brings its own.
export S3_PROFILE='minio'
export S3_REGION='us-east-1'
export S3_ENDPOINT='http://minio:9000'
export S3_BUCKET='hamrecorder-test'
# Required for MinIO: without it the SDK addresses the bucket as a subdomain,
# which does not resolve.
export S3_FORCE_PATH_STYLE='true'
# Public, unlike S3_ENDPOINT - it is baked into each call's playback URL and has
# to resolve from the browser.
export S3_PUBLIC_URL="http://media.${DOMAIN_NAME}/hamrecorder-test"

export TAG=2.0
# How long a call is kept. No longer only a UI label: backend/retention.js reads
# it and, at 3am each day, deletes every call past it AND that call's audio from
# the object store. Starred calls are exempt until the last star is removed.
# ARCHIVE_DAYS overrides it for the sweep alone.
export REACT_APP_ARCHIVE_DAYS=30

export STAGE=test
export NODE_ENV="test"
export PROTOCOL="http://"

export REACT_APP_BACKEND_SERVER="${PROTOCOL}api.${DOMAIN_NAME}"
export REACT_APP_FRONTEND_SERVER="${PROTOCOL}${DOMAIN_NAME}"
export REACT_APP_ACCOUNT_SERVER="${PROTOCOL}account.${DOMAIN_NAME}"
export REACT_APP_ADMIN_SERVER="${PROTOCOL}admin.${DOMAIN_NAME}"
export REACT_APP_COOKIE_DOMAIN=".${DOMAIN_NAME}"

