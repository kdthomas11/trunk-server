.DS_Store
prod.env
test.env
account/.eslintcache
account/.eslintcache
admin/.eslintcache
frontend/.eslintcache
admin/.eslintcache
data/*

# Local env backups - these hold live Mailjet/S3 credentials
*.env.bak

# multer scratch dir for talkgroup CSV uploads
admin/server/uploads/

# Never commit installed dependencies. The root ones were committed by
# accident - there is no package.json at the root at all.
node_modules/

# Python bytecode - the whisper container writes this into the bind mount
__pycache__/
*.pyc

# Any dotted env variant.  used to be tracked while  was
# ignored - two names differing only in word order, one published and one not,
# which is a trap rather than a convention.
.env
.env.*
env.example.openmhz-legacy
