export MAILJET_KEY="FILL IN HERE"
export MAILJET_SECRET="FILL IN HERE"

# --- Mongo authentication ------------------------------------------------
# The mongo service runs with `--auth`, so these are not optional. Every
# service builds its connection string from this pair: the backend and the
# transcriber through backend/config/mongo-url.js, account and admin through
# their config/secrets.js, and the frontend through frontend/server/db.js.
#
# The user must be created in the `scanner` database, NOT `admin`. None of
# those four can set an authSource, so the default - the database named in
# the connection URL - has to be the right one.
#
# MONGO_INITDB_ROOT_USERNAME does not help on an existing database: it only
# fires against an empty data directory. On a server that already holds
# recordings, create the user first and restart with --auth afterwards.
#
# Before restarting a host for the first time with --auth, check it:
#   docker compose exec backend node scripts/check-mongo-auth.js
# It exits non-zero, with the reason, if the services would fail to connect.
#
# Full steps: "Mongo authentication" in README.md.
export MONGO_USER="FILL IN HERE"
export MONGO_PASSWORD="FILL IN HERE"

# Signs the session cookie shared by the account, admin and backend services.
# Must be identical across all three, and unique to this deployment - the value
# that used to be hardcoded in secrets.js is public in every fork of this repo.
# Generate with: openssl rand -base64 48
export SESSION_SECRET="FILL IN HERE"
export REACT_APP_SITE_NAME=HamRecorder
export REACT_APP_ADMIN_EMAIL="admin@hamrecorder.com"
export DOMAIN_NAME="hamrecorder.com"

export S3_PROFILE='default'
export S3_REGION='us-west-001'
export S3_ENDPOINT='https://s3.us-west-1.wasabisys.com'
export S3_BUCKET='hamrecorder-prod'

export TAG=2.0
export REACT_APP_ARCHIVE_DAYS=30

export STAGE=prod
export NODE_ENV="production"
export PROTOCOL="https://"

export REACT_APP_BACKEND_SERVER="${PROTOCOL}api.${DOMAIN_NAME}"
export REACT_APP_FRONTEND_SERVER="${PROTOCOL}${DOMAIN_NAME}"
export REACT_APP_ACCOUNT_SERVER="${PROTOCOL}account.${DOMAIN_NAME}"
export REACT_APP_ADMIN_SERVER="${PROTOCOL}admin.${DOMAIN_NAME}"
export REACT_APP_COOKIE_DOMAIN=".${DOMAIN_NAME}"

# Extra browser origins allowed to send the session cookie, comma separated.
# Normally empty in production - the DOMAIN_NAME-derived origins cover it.
# A wildcard is not an option: browsers reject "*" on credentialed requests.
export EXTRA_CORS_ORIGINS=""
export REACT_APP_GOOGLE_ANALYTICS=""


