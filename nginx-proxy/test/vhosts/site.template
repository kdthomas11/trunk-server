server {
	listen 80;

	server_name api.${DOMAIN_NAME};
	include /etc/nginx/security-headers.conf;
	# Upstream hostnames held in variables so nginx resolves them per request
	# instead of caching the address from config load. See the resolver in
	# nginx.conf. Recreating a container changes its IP; without this nginx
	# keeps dialling the old one and returns 502 until it is reloaded.
	set $upstream_frontend frontend;
	set $upstream_backend backend;
	set $upstream_account account;
	set $upstream_admin admin;
	set $upstream_minio minio;


	location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

	# Regex location: beats the prefix `location /` below, so these two paths
	# are throttled and nothing else on this host is.
	location ~ ^/[^/]+/(contact|authorize)$ {
		limit_req zone=unauth burst=5 nodelay;
		proxy_pass http://$upstream_backend:3005$request_uri;
		include /etc/nginx/proxy.conf;
		access_log /dev/stdout main;
	}

	location / {
		proxy_pass http://$upstream_backend:3005$request_uri;
		include /etc/nginx/proxy.conf;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";
		proxy_set_header Host $host;
		proxy_cache_bypass $http_upgrade;
		access_log /dev/stdout main;
  }
}

server {
	listen 80;

	server_name media.${DOMAIN_NAME};
	include /etc/nginx/security-headers.conf;
	# Upstream hostnames held in variables so nginx resolves them per request
	# instead of caching the address from config load. See the resolver in
	# nginx.conf. Recreating a container changes its IP; without this nginx
	# keeps dialling the old one and returns 502 until it is reloaded.
	set $upstream_frontend frontend;
	set $upstream_backend backend;
	set $upstream_account account;
	set $upstream_admin admin;
	set $upstream_minio minio;


	location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

	# Serves call audio out of MinIO on port 80, so the URL stored on every Call
	# is a hostname instead of an IP:port. A changed LAN address then costs one
	# hosts entry rather than rewriting the url field on every call in the DB.
	location / {
		proxy_pass http://$upstream_minio:9000$request_uri;
		include /etc/nginx/proxy.conf;
		# proxy.conf already sets "Host $host". Setting Host again here made nginx
		# emit two Host headers, and Go's net/http rejects that with a bare
		# text/plain "400 Bad Request" - which looks like a MinIO error but is
		# really a malformed proxied request.
		proxy_http_version 1.1;
		proxy_set_header Connection "";
		# Audio is streamed and seeked with Range requests - buffering whole
		# objects through nginx only adds latency and memory churn.
		proxy_buffering off;
		access_log /dev/stdout main;
	}
}
