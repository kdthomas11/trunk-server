# Per-IP throttling for the two endpoints on api.* that take no session:
# /:shortName/contact sends mail through our Mailjet account, and
# /:shortName/authorize answers whether a system API key is valid. Both are
# limited in the application as well (backend/config/rate-limits.js); this is
# the per-IP half, which those limiters cannot do - they count in one
# container's memory and contact keys on the system being mailed, not on who is
# asking.
#
# Nothing else here is throttled, on purpose. A blanket limit on the API host
# would also catch audio range requests, the socket.io poll and the call list -
# a listener running autoplay would start collecting 429s mid-playback.
#
# The zone this replaced was declared and never applied to a single location,
# which is worse than having none: it reads as though the site is throttled.
limit_req_zone $binary_remote_addr zone=unauth:10m rate=10r/m;
limit_req_status 429;

server {
	listen 80;

  server_name ${DOMAIN_NAME} www.${DOMAIN_NAME};
		# Defence in depth - no XSS sink was found in the app. 'unsafe-inline'
		# is unavoidable for now: React inline styles need it for style-src, and
		# the gtag bootstrap in public/index.html is an inline script. Tightening
		# script-src to a nonce means templating index.html per request.
		#
		# fonts.googleapis.com / fonts.gstatic.com are Semantic UI pulling Lato.
		# Found by loading the page with this policy on and reading the console,
		# which is the only way to get a CSP right the first time.
		add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://img.buymeacoffee.com https://www.googletagmanager.com https://www.google-analytics.com; font-src 'self' data: https://fonts.gstatic.com; media-src 'self' http://api.${DOMAIN_NAME} http://media.${DOMAIN_NAME}; connect-src 'self' http://api.${DOMAIN_NAME} http://account.${DOMAIN_NAME} ws://api.${DOMAIN_NAME} https://www.google-analytics.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
	include /etc/nginx/security-headers.conf;
	# Upstream hostnames held in variables so nginx resolves them per request
	# instead of caching the address from config load. See the resolver in
	# nginx.conf. Recreating a container changes its IP; without this nginx
	# keeps dialling the old one and returns 502 until it is reloaded.
	set $upstream_frontend frontend;
	set $upstream_backend backend;
	set $upstream_account account;
	set $upstream_admin admin;
	set $upstream_minio minio;



	location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

   location /static {
		proxy_pass http://$upstream_frontend:3000$request_uri;
		access_log off;
    }

	location /favicon.ico {
		include /etc/nginx/security-headers.conf;
		proxy_pass http://$upstream_frontend:3000$request_uri;
		expires 1M;
		add_header Surrogate-Control "public, max-age=604800";  
		add_header Cache-Control "max-age=604800, public";
		access_log /dev/stdout main;
	}

	location ~* \.(gif|jpg|png)$ {
		include /etc/nginx/security-headers.conf;
                proxy_pass http://$upstream_frontend:3000$request_uri;

				add_header Pragma public;
				add_header Surrogate-Control "public, max-age=604800";  
                add_header Cache-Control "max-age=604800, public";
				expires 1M;
    }

	location  /silence.m4a {
		include /etc/nginx/security-headers.conf;
                proxy_pass http://$upstream_frontend:3000$request_uri;
				access_log /dev/stdout main;

				add_header Surrogate-Control "public, max-age=604800";  
                add_header Cache-Control "max-age=604800, public";
				expires 1M;
    }
	
   location / {
				proxy_pass http://$upstream_frontend:3000$request_uri;
				include /etc/nginx/proxy.conf;
				access_log /dev/stdout main;
    }
}

