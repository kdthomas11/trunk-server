# Per-IP throttling for the two endpoints on api.* that take no session:
# /:shortName/contact sends mail through our Mailjet account, and
# /:shortName/authorize answers whether a system API key is valid. Both are
# limited in the application as well (backend/config/rate-limits.js); this is
# the per-IP half, which those limiters cannot do - they count in one
# container's memory and contact keys on the system being mailed, not on who is
# asking.
#
# Nothing else here is throttled, on purpose. A blanket limit on the API host
# would also catch audio range requests, the socket.io poll and the call list -
# a listener running autoplay would start collecting 429s mid-playback.
#
# The zone this replaced was declared and never applied to a single location,
# which is worse than having none: it reads as though the site is throttled.
limit_req_zone $binary_remote_addr zone=unauth:10m rate=10r/m;
limit_req_status 429;

server {
	listen 80;
	server_name account.${DOMAIN_NAME} api.${DOMAIN_NAME} admin.${DOMAIN_NAME} www.${DOMAIN_NAME} ${DOMAIN_NAME};
	# Upstream hostnames held in variables so nginx resolves them per request
	# instead of caching the address from config load. See the resolver in
	# nginx.conf. Recreating a container changes its IP; without this nginx
	# keeps dialling the old one and returns 502 until it is reloaded.
	set $upstream_frontend frontend;
	set $upstream_backend backend;
	set $upstream_account account;
	set $upstream_admin admin;
	set $upstream_minio minio;


	location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

	return 301 https://$host$request_uri;
}


server {
	listen 443 ssl;
	ssl_certificate /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;
        ssl_protocols TLSv1 TLSv1.1 TLSv1.2;
        ssl_prefer_server_ciphers on;
        ssl_ciphers 'ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-DSS-AES128-GCM-SHA256:kEDH+AESGCM:ECDHE-RSA-AES128-SHA256:ECDHE-ECDSA-AES128-SHA256:ECDHE-RSA-AES128-SHA:ECDHE-ECDSA-AES128-SHA:ECDHE-RSA-AES256-SHA384:ECDHE-ECDSA-AES256-SHA384:ECDHE-RSA-AES256-SHA:ECDHE-ECDSA-AES256-SHA:DHE-RSA-AES128-SHA256:DHE-RSA-AES128-SHA:DHE-DSS-AES128-SHA256:DHE-RSA-AES256-SHA256:DHE-DSS-AES256-SHA:DHE-RSA-AES256-SHA:AES128-GCM-SHA256:AES256-GCM-SHA384:AES128-SHA256:AES256-SHA256:AES128-SHA:AES256-SHA:AES:CAMELLIA:DES-CBC3-SHA:!aNULL:!eNULL:!EXPORT:!DES:!RC4:!MD5:!PSK:!aECDH:!EDH-DSS-DES-CBC3-SHA:!EDH-RSA-DES-CBC3-SHA:!KRB5-DES-CBC3-SHA';
        ssl_session_timeout 1d;
        ssl_session_cache shared:SSL:50m;
       #ssl_stapling on;
       #ssl_stapling_verify on;
        #add_header Strict-Transport-Security max-age=15768000;

        server_name ${DOMAIN_NAME} www.${DOMAIN_NAME};
	# Upstream hostnames held in variables so nginx resolves them per request
	# instead of caching the address from config load. See the resolver in
	# nginx.conf. Recreating a container changes its IP; without this nginx
	# keeps dialling the old one and returns 502 until it is reloaded.
	set $upstream_frontend frontend;
	set $upstream_backend backend;
	set $upstream_account account;
	set $upstream_admin admin;
	set $upstream_minio minio;


	location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

   location /static {
		proxy_pass http://$upstream_frontend:3000$request_uri;
		access_log off;
    }

	location /favicon.ico {
		proxy_pass http://$upstream_frontend:3000$request_uri;
		expires 1M;
		add_header Surrogate-Control "public, max-age=2629746";  
		add_header Cache-Control "max-age=2629746, public";
		access_log off;
	}

	location /*.png {
                proxy_pass http://$upstream_frontend:3000$request_uri;
                access_log off;
                expires 1M;
				add_header Surrogate-Control "public, max-age=2629746";  
                add_header Cache-Control "max-age=2629746, public";
    }

	location  /*.m4a {
                proxy_pass http://$upstream_frontend:3000$request_uri;
                access_log off;
                expires 1M;
				add_header Surrogate-Control "public, max-age=2629746";  
                add_header Cache-Control "max-age=2629746, public";
    }

   location / {
		proxy_pass http://$upstream_frontend:3000$request_uri;
		access_log /dev/stdout main;
    }
}

server {
	listen 443 ssl;
	ssl_certificate /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;
        ssl_protocols TLSv1 TLSv1.1 TLSv1.2;
        ssl_prefer_server_ciphers on;
        ssl_ciphers 'ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-DSS-AES128-GCM-SHA256:kEDH+AESGCM:ECDHE-RSA-AES128-SHA256:ECDHE-ECDSA-AES128-SHA256:ECDHE-RSA-AES128-SHA:ECDHE-ECDSA-AES128-SHA:ECDHE-RSA-AES256-SHA384:ECDHE-ECDSA-AES256-SHA384:ECDHE-RSA-AES256-SHA:ECDHE-ECDSA-AES256-SHA:DHE-RSA-AES128-SHA256:DHE-RSA-AES128-SHA:DHE-DSS-AES128-SHA256:DHE-RSA-AES256-SHA256:DHE-DSS-AES256-SHA:DHE-RSA-AES256-SHA:AES128-GCM-SHA256:AES256-GCM-SHA384:AES128-SHA256:AES256-SHA256:AES128-SHA:AES256-SHA:AES:CAMELLIA:DES-CBC3-SHA:!aNULL:!eNULL:!EXPORT:!DES:!RC4:!MD5:!PSK:!aECDH:!EDH-DSS-DES-CBC3-SHA:!EDH-RSA-DES-CBC3-SHA:!KRB5-DES-CBC3-SHA';
        ssl_session_timeout 1d;
        ssl_session_cache shared:SSL:50m;
        ssl_stapling on;
        ssl_stapling_verify on;
        add_header Strict-Transport-Security max-age=15768000;

	server_name api.${DOMAIN_NAME};
	# Upstream hostnames held in variables so nginx resolves them per request
	# instead of caching the address from config load. See the resolver in
	# nginx.conf. Recreating a container changes its IP; without this nginx
	# keeps dialling the old one and returns 502 until it is reloaded.
	set $upstream_frontend frontend;
	set $upstream_backend backend;
	set $upstream_account account;
	set $upstream_admin admin;
	set $upstream_minio minio;


		location /.well-known/acme-challenge/ {
			root /var/www/certbot;
		}


	# Regex location: beats the prefix `location /` below, so these two paths
	# are throttled and nothing else on this host is.
	location ~ ^/[^/]+/(contact|authorize)$ {
		limit_req zone=unauth burst=5 nodelay;
		proxy_pass http://$upstream_backend:3005$request_uri;
		include /etc/nginx/proxy.conf;
		access_log /dev/stdout main;
	}

	location / {
		proxy_pass http://$upstream_backend:3005$request_uri;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";
		proxy_set_header Host $host;
		proxy_cache_bypass $http_upgrade;
		include /etc/nginx/proxy.conf;
		access_log    off; 
  }
}


